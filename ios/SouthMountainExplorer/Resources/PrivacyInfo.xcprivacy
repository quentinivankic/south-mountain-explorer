<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app does not track users (no cross-app/website tracking,
	     no data shared with data brokers). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Data collected via PostHog analytics + the in-app feedback form.
	     Hikes, GPS location, and the Sign in with Apple credential still
	     never leave the device; area fetches (cdn.trekdex.app) and trail
	     queries (Overpass / Nominatim) carry map coordinates, not
	     personal data. What IS collected:
	       - Product Interaction: the app's own explicit, bucketed usage
	         events (analytics). Not linked to identity, not for tracking.
	       - Other User Content: the message a user types into "Send
	         Feedback" (app functionality — reading/acting on feedback).
	       - Email Address: only if a user chooses to add one to their
	         feedback for a reply (app functionality).
	     The PostHog SDK ships its own privacy manifest declaring the
	     identifiers/diagnostics it adds. Nothing is used for tracking
	     (no IDFA, no cross-app tracking, no data brokers). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- MetricKit-derived crash/hang signal. Only a COUNT is
			     sent off-device (never the crash log), but declared as
			     Crash Data to be conservative for App Review. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Required-reason API declarations. Only UserDefaults is used;
	     the app does not touch file-timestamp, system-boot-time, or
	     disk-space APIs (verified by source audit). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info stored in UserDefaults by the
				     app itself, only accessible to the app / its
				     app group. Matches how the app stores its own
				     preferences + progress. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
